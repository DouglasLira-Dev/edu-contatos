<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns:fx="http://javafx.com/fxml" fx:controller="br.educontatos.view.CadastroController" spacing="15">
    <padding><Insets top="20" bottom="20" left="20" right="20"/></padding>

    <Label fx:id="lblTitulo" text="Dados do Contato" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>

    <GridPane hgap="10" vgap="15">
        <Label text="Setor *:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <TextField fx:id="txtNome" promptText="Ex: Recursos Humanos" GridPane.rowIndex="0" GridPane.columnIndex="1" prefWidth="300"/>

        <Label text="Responsável:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <TextField fx:id="txtResponsavel" promptText="Ex: Maria Silva" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

        <Label text="Ramal:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
        <TextField fx:id="txtRamal" promptText="Ex: 1234" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

        <Label text="E-mail:" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
        <TextField fx:id="txtEmail" promptText="Ex: rh@educacao.mg.gov.br" GridPane.rowIndex="3" GridPane.columnIndex="1"/>
    </GridPane>

    <HBox spacing="10" alignment="CENTER_RIGHT">
        <Button text="Salvar" onAction="#salvar" style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 8px 20px; -fx-cursor: hand;"/>
        <Button text="Cancelar" onAction="#cancelar" style="-fx-background-color: #95a5a6; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 8px 20px; -fx-cursor: hand;"/>
    </HBox>
</VBox>