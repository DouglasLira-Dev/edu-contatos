<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="br.educontatos.view.CadastroController"
      spacing="15"
      style="-fx-background-color: #ffffff;"
      stylesheets="@../css/style.css">
    <padding><Insets top="25" bottom="25" left="25" right="25"/></padding>

    <Label fx:id="lblTitulo" text="Dados do Contato" styleClass="header-label" style="-fx-font-size: 20px;"/>

    <GridPane hgap="10" vgap="15">
        <Label text="Setor *:" GridPane.rowIndex="0" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
        <TextField fx:id="txtNome" promptText="Ex: Recursos Humanos" GridPane.rowIndex="0" GridPane.columnIndex="1" prefWidth="350"/>

        <Label text="Responsável:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <TextField fx:id="txtResponsavel" promptText="Ex: Maria Silva" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

        <Label text="Ramal:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
        <TextField fx:id="txtRamal" promptText="Ex: 1234" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

        <Label text="E-mail:" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
        <TextField fx:id="txtEmail" promptText="Ex: rh@educacao.mg.gov.br" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

        <Label text="Descrição:" GridPane.rowIndex="4" GridPane.columnIndex="0" style="-fx-alignment: top-left; -fx-padding: 5 0 0 0;"/>
        <TextArea fx:id="txtDescricao" promptText="Ex: Responsável por contratações, férias, pagamentos..." GridPane.rowIndex="4" GridPane.columnIndex="1" prefHeight="80" wrapText="true"/>
    </GridPane>

    <!-- Ajuste no padding do HBox -->
    <HBox spacing="10" alignment="CENTER_RIGHT">
        <VBox.margin><Insets top="15"/></VBox.margin>
        <Button text="Salvar" onAction="#salvar" styleClass="btn-primary"/>
        <Button text="Cancelar" onAction="#cancelar" styleClass="btn-danger"/>
    </HBox>
</VBox>