<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns:fx="http://javafx.com/fxml" fx:controller="br.educontatos.view.IAController" spacing="15" style="-fx-background-color: #ffffff;">
    <padding><Insets top="25" bottom="25" left="25" right="25"/></padding>

    <Label text="🤖 Assistente Virtual" styleClass="header-label" style="-fx-font-size: 20px;"/>
    <Label text="Digite o que você precisa e eu encontro o setor responsável." styleClass="sub-header-label"/>

    <HBox spacing="10">
        <TextField fx:id="txtPergunta" promptText="Ex: Quem cuida da merenda escolar?" HBox.hgrow="ALWAYS"/>
        <Button text="Buscar" onAction="#buscarResposta" styleClass="btn-secondary"/>
    </HBox>

    <TextArea fx:id="txtResposta" editable="false" wrapText="true" prefHeight="150" style="-fx-font-size: 14px; -fx-control-inner-background: #ecf0f1;"/>
</VBox>