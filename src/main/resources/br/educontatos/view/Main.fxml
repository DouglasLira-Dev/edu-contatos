<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="br.educontatos.view.MainController"
            stylesheets="@../css/style.css">
    <top>
        <VBox spacing="5" alignment="CENTER">
            <padding><Insets top="30" bottom="20" left="20" right="20"/></padding>
            <Label text="Central de Contatos" styleClass="header-label"/>
            <Label text="Consulte ramais e e-mails dos setores da Secretaria" styleClass="sub-header-label"/>

            <!-- Removido o -fx-margin-top inválido -->
            <TextField fx:id="txtBusca" promptText="🔍 Digite o nome do setor, responsável ou ramal para buscar..." prefWidth="600">
                <VBox.margin><Insets top="15"/></VBox.margin>
            </TextField>
        </VBox>
    </top>

    <center>
        <TableView fx:id="tabelaContatos">
            <BorderPane.margin>
                <Insets left="20" right="20"/>
            </BorderPane.margin>
            <columns>
                <TableColumn fx:id="colNome" text="Setor" prefWidth="150"/>
                <TableColumn fx:id="colResponsavel" text="Responsável" prefWidth="150"/>
                <TableColumn fx:id="colRamal" text="Ramal" prefWidth="80"/>
                <TableColumn fx:id="colEmail" text="E-mail" prefWidth="200"/>
                <TableColumn fx:id="colDescricao" text="Descrição" prefWidth="250"/>
            </columns>
        </TableView>
    </center>

    <bottom>
        <HBox spacing="15" alignment="CENTER_RIGHT">
            <padding><Insets top="20" bottom="20" left="20" right="20"/></padding>
            <Button text="🔍 Busca Inteligente" onAction="#abrirIA" styleClass="btn-secondary"/>
            <Button text="+ Novo Contato" onAction="#abrirCadastro" styleClass="btn-primary"/>
            <Button text="Editar" onAction="#editarSelecionado" styleClass="btn-secondary"/>
            <Button text="Excluir" onAction="#excluirSelecionado" styleClass="btn-danger"/>
        </HBox>
    </bottom>
</BorderPane>